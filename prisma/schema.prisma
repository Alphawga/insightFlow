// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  accounts      Account[]
  sessions      Session[]
  workspaces    UserWorkspace[]
  onboarding    OnboardingProgress[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workspace {
  id          String    @id @default(cuid())
  name        String
  users       UserWorkspace[]
  integrationAccounts IntegrationAccount[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model UserWorkspace {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        String    // OWNER, ADMIN, MEMBER
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, workspaceId])
}

model IntegrationAccount {
  id          String    @id @default(cuid())
  workspaceId String
  platform    String    // GOOGLE_ADS, SHOPIFY, STRIPE, GA4, META_ADS, MAILCHIMP, etc.
  accountId   String    // External platform account ID (e.g., Shop name, Property ID, Ad Account ID)
  name        String
  status      String    // ACTIVE, DISCONNECTED, ERROR, NEEDS_REAUTH
  credentials Json?     // Encrypted credentials (OAuth tokens, API Keys, secrets, etc.)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Google Ads specific fields (make optional)
  customerName    String?     @map("customer_name") // Optional: Google Ads customer name
  developerToken  String?     @map("developer_token") // Optional: Google Ads developer token
  loginCustomerId String?     @map("login_customer_id") // Optional: Manager account ID if applicable

  // Relations primarily for Ads platforms (conditionally used in application logic)
  conversionActions ConversionAction[]
  campaigns       Campaign[]
  metrics         AdMetrics[] // Still named AdMetrics, only relevant for Ads platforms
  alerts          Alert[]

  // Generic Sync Status
  lastSyncedAt DateTime? @map("last_synced_at")
  syncStatus   String?   @map("sync_status") // SYNCING, SUCCESS, ERROR
  syncError    String?   @map("sync_error") @db.Text

  @@unique([platform, accountId])
  @@map("integration_accounts") // Renamed the underlying table
}

// ConversionAction now relates to IntegrationAccount
model ConversionAction {
  id                 String             @id @default(cuid())
  integrationAccountId String             @map("integration_account_id")
  integrationAccount IntegrationAccount @relation(fields: [integrationAccountId], references: [id], onDelete: Cascade)
  externalId         String             @map("external_id") // ID from Google Ads
  name               String
  category           String             // PURCHASE, SIGNUP, etc.
  status             String             // ENABLED, DISABLED
  isPrimary          Boolean            @default(false) @map("is_primary")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@unique([integrationAccountId, externalId])
  @@map("conversion_actions")
}

model OnboardingProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  step        String    // WELCOME, WORKSPACE_SETUP, ADS_CONNECTION, etc.
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, step])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Campaign now relates to IntegrationAccount
model Campaign {
  id                 String             @id @default(cuid())
  integrationAccountId String             @map("integration_account_id")
  integrationAccount IntegrationAccount @relation(fields: [integrationAccountId], references: [id], onDelete: Cascade)
  externalId         String             @map("external_id") // Google Ads Campaign ID
  name               String
  status             String             // ENABLED, PAUSED, REMOVED
  budget             Float?
  budgetType         String?            @map("budget_type") // DAILY, LIFETIME
  startDate          DateTime?          @map("start_date")
  endDate            DateTime?          @map("end_date")
  metrics            AdMetrics[]
  deviceMetrics      DeviceMetrics[]
  adGroups           AdGroup[]
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@unique([integrationAccountId, externalId])
  @@map("campaigns")
}

// AdMetrics now relates to IntegrationAccount
model AdMetrics {
  id                 String             @id @default(cuid())
  integrationAccountId String             @map("integration_account_id")
  campaignId         String?            @map("campaign_id")
  adGroupId          String?            @map("ad_group_id")
  date               DateTime
  impressions        Int
  clicks             Int
  cost               Float
  conversions        Int
  conversionValue    Float              @map("conversion_value")
  ctr                Float              // Click-through rate
  cpc                Float              // Cost per click
  roas               Float              // Return on ad spend
  integrationAccount IntegrationAccount @relation(fields: [integrationAccountId], references: [id], onDelete: Cascade)
  campaign           Campaign?          @relation(fields: [campaignId], references: [id])
  adGroup            AdGroup?           @relation(fields: [adGroupId], references: [id])
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@unique([integrationAccountId, campaignId, adGroupId, date])
  @@map("ad_metrics")
}

model DeviceMetrics {
  id            String    @id @default(cuid())
  campaignId    String
  campaign      Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  date          DateTime
  device        String    // DESKTOP, MOBILE, TABLET
  impressions   Int
  clicks        Int
  cost          Float
  conversions   Int
  conversionValue Float
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([campaignId, date, device])
}

// Alert now relates to IntegrationAccount
model Alert {
  id                 String             @id @default(cuid())
  integrationAccountId String             @map("integration_account_id")
  integrationAccount IntegrationAccount @relation(fields: [integrationAccountId], references: [id], onDelete: Cascade)
  metric             String             // CTR, CPC, ROAS, etc.
  condition          String             // LESS_THAN, GREATER_THAN, etc.
  threshold          Float
  enabled            Boolean            @default(true)
  emailEnabled       Boolean            @default(true) @map("email_enabled")
  lastTriggered      DateTime?          @map("last_triggered")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@map("alerts")
}

model AdGroup {
  id              String    @id @default(cuid())
  name            String
  status          String    // ENABLED, PAUSED
  cpcBid          Float
  targeting       Json?     // Store targeting as JSON
  description     String?
  platformAdGroupId String  // ID from Google Ads
  campaignId      String
  campaign        Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  metrics         AdMetrics[] // Add this line to establish the relation
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([platformAdGroupId, campaignId])
}